# ---- VibeSpace gitignore ----------------------------------------------------

# Secrets — never commit real configuration
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
htmlcov/
.coverage

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local media scratch space (objects belong in S3-compatible storage)
media/
tmp/
*.mp4
*.mov
*.webm
!frontend/public/**/*.mp4

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
base44/.app.jsonc

.env
.env.*
!.env.example
node_modules/
__pycache__/
.venv/

