# ---- VibeSpace configuration template ---------------------------------------
# Copy to .env and fill in real values. NEVER commit the filled .env file.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
ENVIRONMENT=development                 # development | production
DEBUG=true
SECRET_KEY=replace-with-64-random-bytes # openssl rand -hex 64
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PUBLIC_APP_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# Render provides PORT automatically; the app falls back to 8000 locally.
PORT=8000

# ---------------------------------------------------------------------------
# Database (Render PostgreSQL injects this connection string)
# ---------------------------------------------------------------------------
# Local docker-compose: postgresql+psycopg://vibespace:vibespace@localhost:5432/vibespace
DATABASE_URL=postgresql+psycopg://vibespace:vibespace@localhost:5432/vibespace
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# Redis (cache + Celery broker + WebSocket fan-out)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# ---------------------------------------------------------------------------
# Object storage — S3-compatible (Cloudflare R2, AWS S3, MinIO, Backblaze B2…)
# For R2: endpoint https://<account_id>.r2.cloudflarestorage.com
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=vibespace-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_PUBLIC_BASE_URL=https://media.example.com   # public/CDN base for published media
S3_USE_PATH_STYLE=false                        # true for MinIO
UPLOAD_MAX_BYTES=262144000                     # 250 MB
UPLOAD_URL_TTL_SECONDS=900
MEDIA_URL_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Video processing (FFmpeg binary paths inside the container / host)
# ---------------------------------------------------------------------------
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
VIDEO_RENDITIONS=720p,480p
VIDEO_PROCESSING_ENABLED=true

# ---------------------------------------------------------------------------
# Email (verification + password reset). Leave blank in development: the
# backend then writes the action link to the log instead of sending mail.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=VibeSpace
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# Rate limiting / abuse controls
# ---------------------------------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WRITE_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_HOUR=30
TRUSTED_HOSTS=localhost,127.0.0.1,.onrender.com

# ---------------------------------------------------------------------------
# Frontend (frontend/.env) — safe values only, never secrets in a browser bundle
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
VITE_APP_NAME=VibeSpace